# Copy to .env.local for local work. Real values live in Vercel, never in git.

# Production domain, no trailing slash. Used for canonicals, og:url, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://brushybearpainters.example

# Leave "false" until the company is licensed and the real domain is live.
# Changing it needs a redeploy (it's read at build time).
SITE_INDEXABLE=false

# Brushy Bear's own n8n webhook (server only). Never EA Pro's.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# "true" on previews: form submissions are checked and logged, not sent.
LEADS_DRY_RUN=true

# Added automatically when the Vercel Blob store is connected (build Phase 3).
BLOB_READ_WRITE_TOKEN=

# Optional. The GA4 script loads only when this is set.
NEXT_PUBLIC_GA4_ID=
