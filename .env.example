# Copy to .env.local for local work. Real values live in Vercel, never in git.

# Production domain, no trailing slash. Used for canonicals, og:url, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://brushybearpainters.example

# Leave "false" until the company is licensed and the real domain is live.
# Changing it needs a redeploy (it's read at build time).
SITE_INDEXABLE=false

# Where /api/lead forwards each lead (server only): Brushy Bear's own n8n
# webhook, never EA Pro's. The old N8N_WEBHOOK_URL / N8N_WEBHOOK_SECRET
# names still work as a fallback.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# "true" on previews: form submissions are checked and logged, not sent.
LEADS_DRY_RUN=true

# Added automatically when the Vercel Blob store is connected (build Phase 3).
BLOB_READ_WRITE_TOKEN=

# "on" after enabling Web Analytics in the Vercel dashboard (Analytics tab).
# Until then the script isn't loaded (it would 404 and log a console error).
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Optional. The GA4 script loads only when this is set.
NEXT_PUBLIC_GA4_ID=

# Optional. A Cal.com / Calendly / Google booking page URL. When set, the
# form's thank-you screen shows it so people can book their walkthrough.
NEXT_PUBLIC_BOOKING_URL=
